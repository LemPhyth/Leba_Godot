  "dialogues": {
    "root_2_open": {
      "source_sprite_id": 7009,
      "frames": [
        {
          "source_frame": 1,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 6989,
              "text": "嗯...这里是哪里？我迷路了吗",
              "source_path": "res/texts/6989.txt"
            }
          ]
        },
        {
          "source_frame": 2,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 6993,
              "text": "对了，怎么操作来着？？",
              "source_path": "res/texts/6993.txt"
            }
          ]
        },
        {
          "source_frame": 3,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 6994,
              "text": "←,→:移动 ↓:后跳 Z:重击 X:普攻 C:跳跃 V:抓取技能 A,S,D,F,G,H,Q,W,E,R,T,Y:技能  ...应该是这样吧！",
              "source_path": "res/texts/6994.txt"
            }
          ]
        },
        {
          "source_frame": 4,
          "texts": [
            {
              "source_text_id": 6997,
              "text": "- 哥布林",
              "source_path": "res/texts/6997.txt"
            },
            {
              "source_text_id": 6998,
              "text": "嗯？你是谁",
              "source_path": "res/texts/6998.txt"
            }
          ]
        },
        {
          "source_frame": 5,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 6999,
              "text": "我是雷斯特瓦。我正在寻找非法改造重武器的枪炮师",
              "source_path": "res/texts/6999.txt"
            }
          ]
        },
        {
          "source_frame": 6,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 7000,
              "text": "也许你知道怎么走？",
              "source_path": "res/texts/7000.txt"
            }
          ]
        },
        {
          "source_frame": 7,
          "texts": [
            {
              "source_text_id": 6997,
              "text": "- 哥布林",
              "source_path": "res/texts/6997.txt"
            },
            {
              "source_text_id": 7001,
              "text": "并不",
              "source_path": "res/texts/7001.txt"
            }
          ]
        },
        {
          "source_frame": 8,
          "texts": [
            {
              "source_text_id": 6988,
              "text": "- 雷巴",
              "source_path": "res/texts/6988.txt"
            },
            {
              "source_text_id": 7002,
              "text": "那好吧...",
              "source_path": "res/texts/7002.txt"
            }
          ]
        }
      ],
